{
  "kind": "collectionType",
  "collectionName": "portal_accounts",
  "info": {
    "singularName": "portal-account",
    "pluralName": "portal-accounts",
    "displayName": "Portal Account",
    "description": "Client portal logins. Holds a password hash and the MT5 account the client claims. NEVER expose to the Public role."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "passwordHash": {
      "type": "string",
      "required": true
    },
    "mt5Login": {
      "type": "biginteger",
      "unique": true
    },
    "mt5Name": {
      "type": "string"
    },
    "linkStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "required": true
    },
    "reviewedAt": {
      "type": "datetime"
    },
    "reviewedBy": {
      "type": "string"
    },
    "reviewNote": {
      "type": "string"
    },
    "referralCode": {
      "type": "string"
    },
    "referralStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "required": true
    },
    "referralReviewNote": {
      "type": "string"
    },
    "lastLoginAt": {
      "type": "datetime"
    },
    "cashbackClaims": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::cashback-claim.cashback-claim",
      "mappedBy": "portalAccount"
    },
    "referralClaims": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::referral-claim.referral-claim",
      "mappedBy": "portalAccount"
    }
  }
}
